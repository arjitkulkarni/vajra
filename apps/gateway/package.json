{
  "name": "@vajra/gateway",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --version && tsc --noEmit --strict -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "tsx scripts/e2e.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "db:generate": "drizzle-kit generate",
    "admin:url": "tsx scripts/admin-url.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@grpc/grpc-js": "^1.12.4",
    "@hyperledger/fabric-gateway": "^1.7.0",
    "@vajra/contracts": "workspace:*",
    "@vajra/policy": "workspace:*",
    "@vajra/trust": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.1.0",
    "fastify-type-provider-zod": "^4.0.2",
    "jose": "^5.9.6",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8",
    "@vajra/chain-logic": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
