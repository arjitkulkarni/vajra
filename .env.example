# ─── VAJRA Trust Gateway ────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Database: pglite (embedded, zero setup) | postgres (DATABASE_URL, e.g. Neon)
DB_MODE=pglite
PGLITE_DIR=./data/pglite
DATABASE_URL=

# Ledger: lite (simulated hash-chained blocks in the DB) | fabric (Hyperledger Fabric Gateway)
LEDGER_MODE=lite
FABRIC_CHANNEL=vajrachannel
FABRIC_CHAINCODE=vajra-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=

# Asset storage: fs (content-addressed local store) | ipfs (Kubo HTTP API) | pinata
STORAGE_MODE=fs
STORAGE_DIR=./storage
IPFS_API_URL=http://127.0.0.1:5001
PINATA_JWT=

# Risk scoring: local (in-process TypeScript scorer) | http (Python service)
RISK_MODE=local
RISK_SERVICE_URL=http://127.0.0.1:8100
RISK_TIMEOUT_MS=150

# Analyst (LLM narratives — never in the decision path): template | claude
ANALYST_MODE=template
ANTHROPIC_API_KEY=
ANALYST_MODEL=

# Secrets — generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_JWT_SECRET=change-me-session-secret
MASTER_KEK=change-me-32-byte-base64url-key
PROOF_SIGNING_SEED=change-me-proof-signing-seed
ISSUER_DID=did:web:vajra.local

# The five verifications: confidence floors, as integers 0-100.
# FACE_MATCH_MIN_SCORE is calibrated so 45 is exactly the face model's operating point: AdaFace
# cosine similarity 0.32, or a 0.55 face-api descriptor distance. Raise it to be stricter.
# LIVENESS_MIN_SCORE is the passive anti-spoof composite over depth, motion, reaction, focus, texture.
FACE_MATCH_MIN_SCORE=45
LIVENESS_MIN_SCORE=45
# The live AI check (MiniFASNet): the live probability a capture must reach, 0-100, or it is treated
# as a presentation attack — refused, and escalated to an S3 incident that locks the identity's
# sessions. Not a confidence dial: the model is emphatic in both directions, so anything from about
# 10 to 90 classifies the same captures the same way. A capture with no AI check reported (no model
# weights on that device) is recorded as unmeasured, never as a pass.
ANTISPOOF_MIN_LIVE=50

# Demo mode allows scenario headers, seeded role logins, simulated outages,
# and the pre-enrolment /v1/onboard path (which skips administrator approval).
# Which addresses may reach the administrative plane (/v1/admin/*, revoke, policies,
# incident close). Comma-separated: `loopback`, a single IPv4/IPv6 address, or an IPv4 CIDR.
# Empty = unrestricted. Checked against the socket peer, never against X-Forwarded-For.
ADMIN_IP_ALLOWLIST=

# The third control on the administrative plane, independent of role and of network: the console is
# opened from a link carrying a key derived from this secret, and the gateway re-derives and checks
# that key on every /v1/admin/* call. `pnpm admin:url` prints the current link; the gateway also
# prints it at boot. Changing this value revokes every link handed out before it.
#
# It is NOT a way in on its own — the admin role check still runs behind it — but it is the
# difference between "anyone who reaches this host can try" and "you had to be given the address".
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_CONSOLE_SECRET=

DEMO_MODE=true

# ─── Web app ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Liveness: faceapi (real, on-device) | simulated (no camera or no weights; shows a SIMULATED badge)
# Run `pnpm models:fetch` once before using faceapi — face-api's weights come out of node_modules,
# the AdaFace backbone that does the actual matching is downloaded once (~174 MB).
NEXT_PUBLIC_LIVENESS_MODE=faceapi
# Passive anti-spoofing score a capture must reach, 0-1. Raise it to be harsher.
NEXT_PUBLIC_LIVENESS_MIN_SCORE=0.45
# The live AI check runs whenever `pnpm models:fetch` has put minifasnet_v2.onnx in place. There is
# no client-side switch for it on purpose: the browser measures and reports, and the gateway decides
# (ANTISPOOF_MIN_LIVE above), so a page cannot excuse itself from the check by declining to send.
# block = refuse to sign when that score is not met | warn = report the score and carry on
NEXT_PUBLIC_LIVENESS_ENFORCE=block
